{
  "name": "loading-list-checker",
  "version": "0.8.0",
  "description": "Compare vessel and quay container lists locally",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist:win": "electron-builder --win nsis --x64",
    "build:web": "node scripts/build-web.js"
  },
  "dependencies": {
    "@e965/xlsx": "0.20.3",
    "csv-parse": "6.1.0",
    "electron-updater": "6.8.9",
    "exceljs": "4.4.0"
  },
  "devDependencies": {
    "@azure/msal-browser": "4.25.0",
    "electron": "39.8.3",
    "electron-builder": "26.0.12",
    "esbuild": "0.28.2"
  },
  "build": {
    "appId": "com.ricoro.loadinglistchecker",
    "productName": "Loading List Checker",
    "files": [
      "src/**/*",
      "package.json",
      "!node_modules/exceljs/dist/**",
      "!node_modules/@e965/xlsx/dist/xlsx*",
      "!node_modules/@e965/xlsx/xlsx.mjs",
      "!node_modules/csv-parse/dist/esm/**",
      "!node_modules/csv-parse/dist/iife/**",
      "!node_modules/csv-parse/dist/umd/**"
    ],
    "win": {
      "target": "nsis"
    },
    "artifactName": "Loading-List-Checker-Setup-${version}.${ext}",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Ricoro",
        "repo": "LoadingListChecker",
        "private": false,
        "releaseType": "release"
      }
    ],
    "electronLanguages": [
      "en-US",
      "en-GB"
    ]
  }
}
